{
  "$schema": "https://biomejs.dev/schemas/stable/schema.json",
  "files": {
    "include": [
      "package.json",
      "tsconfig.json",
      "biome.jsonc",
      "public/**/*.html",
      "scripts/**/*",
      "src/**/*",
      "tests/**/*"
    ],
    "ignoreUnknown": true
  },
  "vcs": {
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "include": ["public/**/*.html"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
